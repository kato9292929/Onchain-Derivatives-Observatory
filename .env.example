# ODO 環境変数(例)。実値は運用者が設定する。秘密鍵はここに置かない(非カストディ)。

# --- サーバ ---
PORT=8080
LOG_LEVEL=info

# --- x402 売り手ゲート ---
# per-call 価格(USDC)
X402_PRICE_USDC=0.01
# 受取先アドレス(Base mainnet)。ODOが決済を受ける側(売り手)。
X402_PAY_TO=0xYOUR_RECEIVING_ADDRESS
# 検証/決済を委譲する facilitator のURL(x402標準の /verify, /settle を持つもの)。
# 未設定だと fail-closed: 支払い提示でも全拒否される。
X402_FACILITATOR_URL=
# 決済まで行うか(true)。verifyのみ(false)。
X402_SETTLE=true
# モード: facilitator(本番) / null(fail-closed) / mock(開発専用・本番禁止)
# 通常は未設定でよい(FACILITATOR_URL有無で自動選択)。
# X402_MODE=mock

# --- 身元(ERC-8004) ---
# 運用者が ODO専用agentId を登録後に設定。AAの55560・InvestXとは別IDにすること。
ODO_AGENT_ID=

# --- 収集 ---
# 1 で fixture モード(オフライン)。
ODO_OFFLINE=0
