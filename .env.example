# ODO 環境変数(例)。実値は運用者が設定する。秘密鍵はここに置かない(非カストディ)。

# --- サーバ ---
PORT=8080
LOG_LEVEL=info

# --- x402 売り手ゲート ---
# per-call 価格(USDC)
X402_PRICE_USDC=0.01
# 受取先アドレス(Base mainnet)。ODOが決済を受ける側(売り手)。
X402_PAY_TO=0xYOUR_RECEIVING_ADDRESS
# CDP(Coinbase)facilitator の認証資格情報。verify/settle は CDP認証(これらから生成するJWT)必須。
# 両方が揃うと本番facilitator(mode=facilitator-cdp)。揃わないと fail-closed(mode=null)。
# 実値は Vercel Project Settings(Production/Preview)に設定し、コミットしない。CDPダッシュボードで発行。
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# facilitator URL は CDP資格情報がある場合、CDPの固定URL(config.url)を使う(JWTがそのhost/pathに束縛)。
# 後方互換で変数は残すが、CDP経路では上書きに使わない。
X402_FACILITATOR_URL=
# 決済まで行うか(true)。verifyのみ(false)。
X402_SETTLE=true
# モード: facilitator-cdp(本番, CDP資格情報あり) / null(fail-closed) / mock(開発専用・本番禁止)
# 通常は未設定でよい(CDP資格情報の有無で自動選択)。
# X402_MODE=mock

# --- 身元(ERC-8004) ---
# 運用者が ODO専用agentId を登録後に設定。AAの55560・InvestXとは別IDにすること。
# 未設定なら「未登録」として扱う(ダミーは入れない)。採点記録はこの値に紐づく。
ODO_AGENT_ID=
# ERC-8004 IdentityRegistry アドレス(現行公開情報で確認)。
ODO_ERC8004_REGISTRY=
# 登録関数シグネチャ(参照実装の目安。現行デプロイで要確認)。
ODO_ERC8004_ABI_FN=newAgent(string,address)
# agent domain / チェーン。
ODO_AGENT_DOMAIN=
ODO_CHAIN=base

# --- agentId 登録スクリプト(Circle Developer-Controlled Wallet)。運用者のみ ---
# これらが揃わないと登録スクリプトは fail-closed(何もしない)。
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=          # hex32。都度 RSA-OAEP で ciphertext を生成する
CIRCLE_WALLET_SET_ID=         # 新規ウォレット作成時に必要
CIRCLE_WALLET_ID=            # 既存ウォレットを使う場合
# ODO_CIRCLE_BLOCKCHAIN=BASE  # Circle の blockchain 識別子(既定 BASE)

# --- 収集 ---
# 1 で fixture モード(オフライン)。
ODO_OFFLINE=0
# Derive ベースURL(既定 https://api.lyra.finance)。
DERIVE_API_URL=

# --- MCP 面 ---
# HTTP(Streamable HTTP)での MCP 公開。false で無効化(既定 有効)。REST と同じく x402 ゲート下。
# ODO_MCP_HTTP=false

# --- Vercel(サーバレス配信)---
# 通常は不要(config/**・data/** は vercel.json の includeFiles で同梱、cwd から解決)。
# ファイル位置を明示したい場合のみ上書き:
# ODO_CONFIG_DIR=
# ODO_DATA_DIR=
# 注: Vercel の秘密情報(facilitator URL / payTo / 価格)は Vercel Project Settings に設定する(ここには置かない)。
# 注: cron→再デプロイ用の Vercel Deploy Hook URL は GitHub の Secrets(VERCEL_DEPLOY_HOOK_URL)に設定する。
